# Google AI Studio API key - Required for AI Coach and recitation audio feedback (Server-side proxy)
GEMINI_API_KEY=

# Secret key for cryptographic student token signatures (Optional, defaults to fallback string)
JWT_SECRET=

# Supabase Configuration Keys for Ilm Nafi Database Integration
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend Mailer API Key for Password Recovery
RESEND_API_KEY=

# Admin Email for Resend (Must be verified in Resend dashboard)
ADMIN_EMAIL=

# ==========================================
# ADVANCED AI INTEGRATIONS (Optional / Production)
# ==========================================

# OpenAI API Key - Used for Whisper Speech-to-Text (Streaming/Audio transcription)
OPENAI_API_KEY=

# ElevenLabs API Key - For ultra-realistic Neural Arabic Text-to-Speech (Teacher Voice)
ELEVENLABS_API_KEY=

# Azure Cognitive Services - Alternative for Speech-to-Text and Text-to-Speech
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

