# ==============================================================================
# NAFI PLATFORM - OPEN SOURCE ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Define sensitive keys and environment settings here. Never commit actual secret 
# values to production source control. Use this file as a template for .env files.

# ------------------------------------------------------------------------------
# 1. CORE API & SERVICES
# ------------------------------------------------------------------------------
# Gemini AI Platform API Key (Required for Tajweed rules extraction and AI Study buddies)
GEMINI_API_KEY=""

# Base URL of the deployed platform (e.g. https://nafi.org or localhost in dev)
APP_URL="http://localhost:3000"

# Developer Environment Mode: development / production / testing
NODE_ENV="development"

# ------------------------------------------------------------------------------
# 2. SEPARATE AUTHENTICATION & SERVICES
# ------------------------------------------------------------------------------
# JWT Authentication Secret Key (Used by auth-service)
JWT_SECRET=""

# Scholarship Service API Key
SCHOLARSHIP_SERVICE_KEY=""

# Adhkar & Spiritual Companion Service Key
ADHKAR_SERVICE_KEY=""

# ------------------------------------------------------------------------------
# 3. TAJWEED PARSING ENGINE & RULE MATRIX
# ------------------------------------------------------------------------------
# Database Connection URI for the rule outputs (PostgreSQL or SQLite)
TAJWEED_DB_URL="postgresql://user:password@localhost:5432/nafi_db"

# Master Scholar Verification Secret Token (used for publishing reviewed rules)
SCHOLAR_VERIFICATION_TOKEN=""
